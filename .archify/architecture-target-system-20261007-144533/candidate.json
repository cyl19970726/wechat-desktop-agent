  "cards": [
    {
      "dot": "emerald",
      "title": "职责分离",
      "items": [
        "原生适配器读写界面；模型不持有任意桌面操作权",
        "业务写入仅由平台后端鉴权并执行",
        "账户租约与操作员接管串行管理 UI"
      ]
    },
    {
      "dot": "amber",
      "title": "可靠性边界",
      "items": [
        "意图防重复提交；纯视觉不能保证端到端 exactly-once",
        "提交、明确失败、结果未知和送达分别记录",
        "窗口或账号变化后旧证据与坐标作废"
      ]
    },
    {
      "dot": "violet",
      "title": "当前建设范围",
      "items": [
        "仓库首先提供可运行的离线发送状态核心",
        "原生适配器、持续监听、模型与操作台仍待实施",
        "官方通道留作独立适配器，客户群适用性须另核"
      ]
    }
